# ---------------------------------------------------------------------------
# Software Factory - environment configuration
# Copy to `.env` and set your deployment's values. `.env` is git-ignored.
# The repo ships generic defaults; override here to point at YOUR deployment.
# ---------------------------------------------------------------------------

# AWS
AWS_REGION=us-east-2
MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Live-resource names (used by the web UI).
#   CRM_LAMBDA_NAME     - the CRM backend Lambda function name
#   UI_LOG_GROUP        - CloudWatch log group the UI writes to
#   DEPLOY_PROJECT_DIR  - folder under deploy_agentcore/ holding your CDK project
CRM_LAMBDA_NAME=crm-backend
UI_LOG_GROUP=/software-factory/ui-demo
DEPLOY_PROJECT_DIR=softwarefactory

# Web UI server (optional)
# WEBUI_HOST=127.0.0.1
# WEBUI_PORT=8090

# Standalone capability demos (identity_demo.py / policy_demo.py) — set to your
# deployment's actual workload name, Cognito domain, and gateway URLs.
FACTORY_WORKLOAD_NAME=software-factory
POLICY_COGNITO_DOMAIN=crm-policy-demo
POLICY_GATEWAY_URL=
CRM_GATEWAY_URL=
