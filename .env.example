# ---------------------------------------------------------------------------
# Software Factory - environment configuration
# Copy to `.env` and fill in for a LIVE AgentCore demo.
# Leave MOCK_MODE=true to run the entire demo locally with no AWS calls.
# NOTE: `.env` is git-ignored — put any deployment-specific / private values
#       here rather than hardcoding them in source.
# ---------------------------------------------------------------------------

# Master switch. true = fully local simulation (safe for live demos).
#                false = call real AgentCore / Bedrock APIs.
MOCK_MODE=true

# AWS
AWS_REGION=us-west-2
MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# AgentCore resource IDs (only needed when MOCK_MODE=false)
BEDROCK_AGENTCORE_MEMORY_ID=
DIRECTOR_RUNTIME_ARN=

# Gateway (only needed when MOCK_MODE=false)
GATEWAY_URL=

# Live-resource names. The repo ships generic defaults; override here to point
# the web UI at YOUR deployment's actual resource names.
#   CRM_LAMBDA_NAME     - the CRM backend Lambda function name
#   UI_LOG_GROUP        - CloudWatch log group the UI writes to
#   DEPLOY_PROJECT_DIR  - folder under deploy_agentcore/ holding your CDK project
CRM_LAMBDA_NAME=crm-backend
UI_LOG_GROUP=/software-factory/ui-demo
DEPLOY_PROJECT_DIR=softwarefactory

# Demo output
ARTIFACT_BUCKET=software-factory-artifacts
LOCAL_ARTIFACT_DIR=./.artifacts

# Standalone demo scripts (identity_demo.py / policy_demo.py) — only needed if
# you run those against your own live deployment. Set to your deployment's
# actual workload name, Cognito domain, and gateway URLs.
FACTORY_WORKLOAD_NAME=software-factory
POLICY_COGNITO_DOMAIN=crm-policy-demo
POLICY_GATEWAY_URL=
CRM_GATEWAY_URL=
